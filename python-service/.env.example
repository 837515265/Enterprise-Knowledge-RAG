# =========================
# 应用端口
# =========================
PARSE_PORT=21084
RETRIEVE_PORT=21085

# =========================
# MySQL（现网）
# =========================
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# =========================
# Elasticsearch（现网）
# =========================
ELASTICSEARCH_URL=

# =========================
# Redis（现网）
# =========================
REDIS_URL=

# =========================
# 解析任务并发
# PARSE_WORKER_COUNT 控制 worker 数量；PARSE_MAX_CONCURRENCY 控制同时执行解析的任务数。
# 超过并发上限的任务会进入 waiting_slot，最多等待 PARSE_SLOT_WAIT_SECONDS。
# =========================
PARSE_WORKER_COUNT=1
PARSE_MAX_CONCURRENCY=1
PARSE_SLOT_WAIT_SECONDS=1800
PARSE_RESET_ACTIVE_ON_STARTUP=true
PARSE_STAGE_LOG_LEVEL=WARNING

# =========================
# Neo4j（现网）
# =========================
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# =========================
# 文件中心
# 例如: http://10.0.0.8:8080/api-ai-center
# 如果 FILE_CENTER_BASE_URL 为空且 NACOS_ENABLED=true，会通过 FILE_CENTER_SERVICE_NAME 发现文件中心。
# =========================
FILE_CENTER_BASE_URL=
FILE_CENTER_SERVICE_NAME=
FILE_CENTER_CONTEXT_PATH=
FILE_CENTER_SCHEME=http
FILE_CENTER_TIMEOUT=120
FILE_CENTER_RETRIES=2
FILE_CENTER_INFO_PATH=/files/ids
FILE_CENTER_DOWNLOAD_PATH=/files/download
FILE_CENTER_UPLOAD_PATH=/files/upload
FILE_CENTER_UPLOAD_MODE=multipart
FILE_CENTER_UPLOAD_PARSE_ARTIFACTS=false
FILE_CENTER_UPLOAD_REQUIRED=false

# =========================
# Nacos 注册与发现
# 默认关闭；本地只调 MySQL/ES/Redis/Neo4j 时不需要开启。
# NACOS_SERVER_ADDR 可填 10.0.0.8:8848、http://10.0.0.8:8848 或 http://10.0.0.8:8848/nacos
# =========================
NACOS_ENABLED=true
APP_ENV=sit
# dev: http://10.10.20.90:8848 | sit: http://10.81.136.30:8848 | prd: http://172.22.136.60:8848
NACOS_SERVER_ADDR=http://10.81.136.30:8848
NACOS_NAMESPACE_ID=
NACOS_GROUP_NAME=DEFAULT_GROUP
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_CONFIG_DATA_ID=app-rag-doc-sit
NACOS_CONFIG_POLL_INTERVAL_SECONDS=15
NACOS_CLUSTER_NAME=DEFAULT
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_REGISTER_IP=
NACOS_EPHEMERAL=true
NACOS_HEARTBEAT_INTERVAL_SECONDS=5
NACOS_PARSE_SERVICE_NAME=danbao-parse-service
NACOS_RETRIEVE_SERVICE_NAME=danbao-retrieve-service
NACOS_PARSE_REGISTER_PORT=21084
NACOS_RETRIEVE_REGISTER_PORT=21085
NACOS_FILE_CENTER_SERVICE_NAME=common-file-center

# =========================
# Java 知识库平台服务
# 具体服务名、context path 等待 Java/运维侧确认后填写。
# JAVA_PLATFORM_BASE_URL 可用于本地直连调试；为空时走 Nacos 服务发现。
# =========================
JAVA_CALLBACK_ENABLED=true
JAVA_PLATFORM_BASE_URL=
JAVA_PLATFORM_SERVICE_NAME=app-knowledge-service
JAVA_PLATFORM_CONTEXT_PATH=
JAVA_PLATFORM_SCHEME=http
JAVA_PARSE_CALLBACK_PATH=/internal/platform/parse-callback
JAVA_SERVICE_TIMEOUT=30
JAVA_SERVICE_RETRIES=2

# =========================
# 内部服务调用统一鉴权和链路追踪
# =========================
SERVICE_CLIENT_TIMEOUT=30
SERVICE_CLIENT_RETRIES=2
SERVICE_AUTH_HEADER=
SERVICE_AUTH_TOKEN=
REQUEST_ID_HEADER=X-Request-Id

# =========================
# OCR
# OCR_BACKEND:
# - mineru: PDF/图片走 MinerU，第一版生产默认主链路
# - paddle_layout: PDF/图片走 Paddle
# - qianfan_vlm: PDF 先转页图，再逐页调用 VLM OCR
# =========================
OCR_BACKEND=mineru
MINERU_BASE_URL=http://124.128.251.51:21189
MINERU_BACKEND=vlm-auto-engine
MINERU_PARSE_METHOD=auto
MINERU_LANG_LIST=ch
MINERU_TIMEOUT=900
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_IMAGE_ANALYSIS=true
MINERU_RETURN_MIDDLE_JSON=false
MINERU_RETURN_CONTENT_LIST=false
MINERU_RETURN_IMAGES=false
PADDLE_OCR_WEB_URL=http://124.128.251.51:8118
PADDLE_OCR_PREDICT_URL=
QIANFAN_OCR_BASE_URL=
QIANFAN_OCR_MODEL=
QIANFAN_OCR_API_KEY=
QIANFAN_OCR_TIMEOUT=600
QIANFAN_OCR_APPEND_THINK=true
QIANFAN_OCR_RENDER_SCALE=2.0
QIANFAN_OCR_PROMPT=

# =========================
# 默认模型配置
# 本地 qwen2.5-32b / new-api 都填这里
# =========================
DEFAULT_MODEL_NAME=qwen2.5-32b
DEFAULT_MODEL_BASE_URL=
DEFAULT_MODEL_API_KEY=EMPTY
DEFAULT_MODEL_MAX_PROMPT_CHARS=28000
MODEL_HTTP_PROXY=
MODEL_HTTPS_PROXY=
MODEL_TIER_THRESHOLD_CHARS=28000

# =========================
# Query Understanding
# 默认回退到 DEFAULT_MODEL_*
# =========================
QUERY_UNDERSTANDING_MODEL_NAME=
QUERY_UNDERSTANDING_BASE_URL=
QUERY_UNDERSTANDING_API_KEY=
QUERY_UNDERSTANDING_TIMEOUT=120

# =========================
# 结构化抽取
# 默认回退到 DEFAULT_MODEL_*
# =========================
EXTRACT_MODEL_NAME=
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_TIMEOUT=120

# =========================
# 切片摘要
# 默认 truncate 不调用模型；设为 llm 时走 SUMMARY_* 或 DEFAULT_MODEL_*。
# =========================
CHUNK_SUMMARY_BACKEND=truncate
SUMMARY_MODEL_NAME=
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
SUMMARY_TIMEOUT=120

# =========================
# Embedding
# OpenAI 兼容 /embeddings
# =========================
EMBEDDING_MODEL_NAME=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=120

# =========================
# Rerank
# 优先走原生 /rerank，失败再回退到 LLM 重排
# =========================
RERANK_MODEL_NAME=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TIMEOUT=120
RERANK_PATH=/rerank

# =========================
# 检索缓存、限流、指标
# RETRIEVE_RATE_LIMIT_PER_MINUTE=0 表示关闭限流
# /metrics 暴露 Prometheus 文本指标
# =========================
RETRIEVE_CACHE_ENABLED=true
RETRIEVE_CACHE_TTL_SECONDS=60
RETRIEVE_RATE_LIMIT_PER_MINUTE=0
RETRIEVE_RATE_LIMIT_WINDOW_SECONDS=60

# =========================
# 超过 32k 时的兜底模型
# =========================
FALLBACK_MODEL_NAME=
FALLBACK_MODEL_BASE_URL=
FALLBACK_MODEL_API_KEY=
FALLBACK_MODEL_TIMEOUT=120

# =========================
# 模型调用重试
# =========================
MODEL_RETRY_ATTEMPTS=3
MODEL_RETRY_MULTIPLIER=1
MODEL_RETRY_MIN_SECONDS=1
MODEL_RETRY_MAX_SECONDS=8
MODEL_RATE_LIMIT_PER_MINUTE=0
MODEL_RATE_LIMIT_WINDOW_SECONDS=60
