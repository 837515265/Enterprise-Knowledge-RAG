# Copy this file to .env.deploy on the deployment server, then edit values.

# Published host port. This is also the port registered to Nacos.
APP_PORT=20751
PARSE_PORT=20751
RETRIEVE_PORT=20751

# Persistent artifact directory inside containers.
DATA_DIR=/app/data
LOG_DIR=/home/appuser/app/logs

# MySQL
MYSQL_HOST=10.10.20.92
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_contract
MYSQL_COLLATION=utf8mb4_general_ci

# Redis
REDIS_URL=redis://10.10.20.90:6379/15

# Elasticsearch
ELASTICSEARCH_URL=http://10.10.20.96:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Neo4j
NEO4J_URI=bolt://10.10.20.45:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Nacos registration/discovery
NACOS_ENABLED=true
# dev: http://10.10.20.90:8848 | sit: http://10.81.136.30:8848 | prd: http://172.22.136.60:8848
NACOS_SERVER_ADDR=
NACOS_NAMESPACE_ID=
NACOS_GROUP_NAME=DEFAULT_GROUP
NACOS_CONFIG_GROUP=DEFAULT_GROUP
NACOS_CLUSTER_NAME=DEFAULT
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_REGISTER_IP=
NACOS_EPHEMERAL=true
NACOS_HEARTBEAT_INTERVAL_SECONDS=5
NACOS_APP_SERVICE_NAME=app-rag-doc
NACOS_PARSE_SERVICE_NAME=danbao-parse-service
NACOS_RETRIEVE_SERVICE_NAME=danbao-retrieve-service
NACOS_PARSE_REGISTER_PORT=20751
NACOS_RETRIEVE_REGISTER_PORT=20751

# Java platform callback target discovered through Nacos.
JAVA_CALLBACK_ENABLED=true
JAVA_PLATFORM_BASE_URL=
JAVA_PLATFORM_SERVICE_NAME=app-knowledge-service
JAVA_PLATFORM_CONTEXT_PATH=
JAVA_PLATFORM_SCHEME=http
JAVA_PARSE_CALLBACK_PATH=/internal/platform/parse-callback
JAVA_SERVICE_TIMEOUT=30
JAVA_SERVICE_RETRIES=2

# File center target discovered through Nacos.
FILE_CENTER_BASE_URL=
FILE_CENTER_SERVICE_NAME=common-file-center
NACOS_FILE_CENTER_SERVICE_NAME=common-file-center
FILE_CENTER_CONTEXT_PATH=
FILE_CENTER_SCHEME=http
FILE_CENTER_TIMEOUT=120
FILE_CENTER_RETRIES=2
FILE_CENTER_INFO_PATH=/files/ids
FILE_CENTER_DOWNLOAD_METHOD=GET
FILE_CENTER_DOWNLOAD_PATH=/files/{id}
FILE_CENTER_UPLOAD_PATH=/files/upload
FILE_CENTER_UPLOAD_MODE=multipart
FILE_CENTER_UPLOAD_PARSE_ARTIFACTS=false
FILE_CENTER_UPLOAD_REQUIRED=false

# Internal service auth header when Java/file-center require it.
SERVICE_CLIENT_TIMEOUT=30
SERVICE_CLIENT_RETRIES=2
SERVICE_AUTH_HEADER=
SERVICE_AUTH_TOKEN=
REQUEST_ID_HEADER=X-Request-Id

# OCR
OCR_BACKEND=paddle_layout
PADDLE_OCR_WEB_URL=
PADDLE_OCR_PREDICT_URL=
PADDLE_OCR_WEB_TIMEOUT=600
OCR_WEB_TIMEOUT=600

# Optional VLM OCR fallback.
QIANFAN_OCR_BASE_URL=
QIANFAN_OCR_MODEL=/models/Qianfan-OCR
QIANFAN_OCR_API_KEY=
QIANFAN_OCR_TIMEOUT=600
QIANFAN_OCR_APPEND_THINK=true
QIANFAN_OCR_RENDER_SCALE=2.0
QIANFAN_OCR_PROMPT=

GLM_OCR_BASE_URL=
GLM_OCR_MODEL=/models/GLM-OCR
GLM_OCR_API_KEY=
GLM_OCR_TIMEOUT=600
GLM_OCR_RENDER_SCALE=2.0
GLM_OCR_PROMPT=

# LLM
DEFAULT_MODEL_NAME=qwen2.5-32b
DEFAULT_MODEL_BASE_URL=
DEFAULT_MODEL_API_KEY=
DEFAULT_MODEL_MAX_PROMPT_CHARS=28000

QUERY_UNDERSTANDING_MODEL_NAME=qwen2.5-32b
QUERY_UNDERSTANDING_BASE_URL=
QUERY_UNDERSTANDING_API_KEY=
QUERY_UNDERSTANDING_TIMEOUT=120

EXTRACT_MODEL_NAME=qwen2.5-32b
EXTRACT_BASE_URL=
EXTRACT_API_KEY=
EXTRACT_TIMEOUT=120

SUMMARY_MODEL_NAME=qwen2.5-32b
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
SUMMARY_TIMEOUT=120

FALLBACK_MODEL_NAME=qwen2.5-32b
FALLBACK_MODEL_BASE_URL=
FALLBACK_MODEL_API_KEY=
FALLBACK_MODEL_TIMEOUT=120

MODEL_RETRY_ATTEMPTS=3
MODEL_RETRY_MULTIPLIER=1
MODEL_RETRY_MIN_SECONDS=1
MODEL_RETRY_MAX_SECONDS=8

# Embedding / rerank
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=120
EMBEDDING_MAX_BATCH_SIZE=64

RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_TIMEOUT=120
RERANK_PATH=/rerank

# Concurrency. Keep parse low if PaddleOCR does not support high concurrency.
PARSE_WORKER_COUNT=1
PARSE_MAX_CONCURRENCY=1
INDEX_WORKER_COUNT=1
