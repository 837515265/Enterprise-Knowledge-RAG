#===============项目相关================
# 项目名称，用于项目内部布局组件和顶部导航展示
VITE_APP_NAME=知识库管理平台
# 访问路径 用于vite public-path 和 路由前缀
VITE_BASE_PATH=/knowledge/web/
# axios请求接口前缀baseUrl
VITE_BASE_URL_PREFIX=/knowledge
# 端口号
VITE_SERVER_PORT=9527
#======================================

#===============统一登录================
# 系统网关前缀，对应【用户中心-菜单管理-服务上下文】字段
VITE_APP_GATEWAY_PREFIX=/api-knowledge
# 统一登录 client-id 对应【用户中心-菜单管理-客户端】字段
VITE_LDSK_CLIENT_ID=knowledge
# 统一登录 项目名称 对应【用户中心-菜单-菜单名称】字段
VITE_LDSK_PROJECT_NAME=前端示例模板工程
#======================================

#===============VFORM=================
# vform表单tenant-id
VITE_LDSK_VFORM_TENANT_ID=SCF-V2
#======================================

# ==============SYSTEM===============
# 是否缓存 用户信息 和 菜单 （开启后会自动缓存 user-store, 且页面刷新时会优先使用缓存数据）
VITE_CACHE_USERINFO=false
# 是否缓存字典（开启后会自动缓存 dict-store, 且页面刷新时会优先使用缓存数据）
VITE_CACHE_DICTIONAYR=false
#======================================

