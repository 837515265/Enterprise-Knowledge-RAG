{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "serve": "npm run dev",
    "build": "vite build --mode production",
    "lint": "eslint --fix \"src/**/*.{js,ts,mts,mjs,jsx,tsx,vue}\" && stylelint --fix \"src/**/*.{less,css,vue}\"",
    "postinstall": "husky install",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "predev": "npm run check:node",
    "prebuild": "npm run check:node",
    "check:node": "node ./build/scripts/check-env.js",
    "preinstall": "npm run check:node",
    "check:ts": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/colors": "^7.2.1",
    "@antv/g6": "^4.8.24",
    "@vueuse/core": "^11.3.0",
    "ant-design-vue": "^1.7.8",
    "axios": "^1.9.0",
    "classnames": "^2.2.6",
    "core-js": "^3.29.1",
    "css-color-function": "^1.3.3",
    "dayjs": "^1.11.13",
    "insert-css": "^2.0.0",
    "js-base64": "^3.7.7",
    "lodash-es": "^4.17.21",
    "markdown-it": "^14.1.1",
    "mitt": "^3.0.1",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "qs": "^6.14.0",
    "store": "^2.0.12",
    "vue": "^2.7.14",
    "vue-container-query": "^0.1.0",
    "vue-copy-to-clipboard": "^1.0.3",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/parser": "^7.27.5",
    "@iconify/json": "^2.2.42",
    "@ldsk/ld-eslint-config": "^1.1.11",
    "@playwright/test": "^1.60.0",
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.3",
    "@types/qs": "^6.14.0",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "@vitejs/plugin-vue2": "^2.2.0",
    "@vitejs/plugin-vue2-jsx": "^1.1.1",
    "autoprefixer": "^10.4.17",
    "husky": "^8.0.0",
    "less": "^3.0.4",
    "lint-staged": "^12.0.0",
    "rollup-plugin-visualizer": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^4.4.4",
    "unplugin-auto-import": "0.13.0",
    "unplugin-icons": "^0.16.1",
    "unplugin-vue-components": "^0.24.1",
    "vite": "^4.2.1",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-vue-inspector": "^5.3.1",
    "vue-template-compiler": "^2.7.14",
    "vue-template-es2015-compiler": "^1.9.1"
  },
  "overrides": {
    "tinyexec": "1.0.1"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix"
    ],
    "src/**/*.vue": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "src/**/*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{md,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=14"
  }
}
