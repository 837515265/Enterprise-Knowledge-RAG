<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ludan.app.mapper.KbChunkRevisionMapper">

    <select id="getMaxRevisionNo" resultType="java.lang.Integer">
        SELECT MAX(revision_no) FROM kb_chunk_revision WHERE chunk_id = #{chunkId}
    </select>

</mapper>
